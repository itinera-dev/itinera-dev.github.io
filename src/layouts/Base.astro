---
// Every page: the head, the skip link, the masthead with the site's
// navigation, the main landmark and the footer.

import '../styles/global.css';

import { book, built, organisation, repository } from '../../site.config.mjs';
import Mark from '../components/Mark.astro';
import { SLOGAN } from '../lib/message.ts';

interface Props {
	/** The page's title, before the site's name; the home page passes none. */
	title?: string;
	description: string;
	/** The page's Markdown copy, for agents, when it has one. */
	markdownPath?: string;
	/** The page's sharing image, made by src/pages/og/[slug].png.ts. */
	image?: string;
	/** The page is the 404 page, which is never indexed. */
	notFound?: boolean;
	/** A wide main column, for a landing page laid out in sections. */
	wide?: boolean;
}

const { title, description, markdownPath, image = '/og/index.png', notFound = false, wide = false } = Astro.props;
const fullTitle = title ? `${title} · Itinera` : `Itinera · ${SLOGAN}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const imageAlt = `${title ?? 'Itinera'}. ${SLOGAN}`;

const NAVIGATION = [
	{ label: 'Why Itinera', href: '/why/' },
	{ label: 'Book', href: book },
	{ label: 'Languages', href: '/languages/' },
	{ label: 'Specification', href: '/specification/' },
	{ label: 'Roadmap', href: '/roadmap/' },
	{ label: 'Contribute', href: '/contribute/' },
];
const current = (href: string) => Astro.url.pathname === href;
const commit = built.commit.slice(0, 7);
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		{/* The page colour of each scheme; scripts/contrast.mjs checks they match tokens.css. */}
		<meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#171a19" media="(prefers-color-scheme: dark)" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/atom+xml" title="Itinera news" href="/news/feed.xml" />
		{markdownPath && <link rel="alternate" type="text/markdown" title="This page in Markdown" href={markdownPath} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Itinera" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image:alt" content={imageAlt} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to the text</a>
		<header class="masthead">
			<div class="masthead__inner">
				<a class="masthead__home" href="/" aria-current={current('/') ? 'page' : undefined}>
					<Mark class="masthead__mark" />
					<span class="masthead__name">Itinera</span>
				</a>
				<nav class="masthead__nav" aria-label="Site">
					<ul>
						{
							NAVIGATION.map(({ label, href }) => (
								<li>
									<a href={href} aria-current={current(href) ? 'page' : undefined}>
										{label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>
		<main id="main" tabindex="-1" class:list={['page', { 'page--wide': wide }]}>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<nav aria-label="More about Itinera">
					<ul class="site-footer__links">
						<li><a href="/releases/">Releases</a></li>
						<li><a href="/news/">News</a></li>
						<li><a href="/news/feed.xml">News feed</a></li>
						<li><a href="/brand/">Brand</a></li>
						<li><a href="/accessibility/">Accessibility</a></li>
						<li><a href="/llms.txt">For agents: llms.txt</a></li>
						{markdownPath && <li><a href={markdownPath}>This page in Markdown</a></li>}
						<li><a href={organisation}>Itinera on GitHub</a></li>
					</ul>
				</nav>
				<p>
					Itinera, and this site, are free software, licensed under
					<a href={`${repository}/blob/main/LICENSE-APACHE`}>Apache 2.0</a> or <a href={`${repository}/blob/main/LICENSE-MIT`}>MIT</a>, at your
					option.
				</p>
				<p>
					Built on {built.date}{
						commit && (
							<>
								{' '}from commit <a href={`${repository}/commit/${built.commit}`}>{commit}</a>
							</>
						)
					}.
				</p>
			</div>
		</footer>
		<script>
			import '../scripts/diagrams.ts';
		</script>
	</body>
</html>
